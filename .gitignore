/.claude
/.commandcode
/.pytest_cache
/.ruff_cache

# Transcripciones de sesiones de Command Code (volcados .jsonl)
*.jsonl
/*-*-*-*-*-*.jsonl

# Scratchpads y outputs efimeros de la sesion
salidas/
scratchpad/
scratchpad_*.py

# Directorios parasitos creados por interpretes de comandos (PowerShell,
# CMD, shells Unix) interpretando mal un argumento o un alias. Aparecen
# cuando una utilidad como `mkdir` o `echo` recibe un argumento y se ejecuta
# en el directorio actual. Si los ves, probablemente algo escribio mal.
echo/
mkdir/
ok/
done/

# Web frontend: dependencias npm y build output
web/node_modules/
web/dist/

# Python bytecode / caches — nunca trackear
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.venv/
venv/
env/

# Datos: NO ignorar — los JSON del simulador son parte del repo
!datos/
!datos/**/*.json
!datos/**/*.csv
datos/__pycache__/
# Documentacion: mantener ignorada (es fuente, no codigo)
# /documentacion
.agents/